<idea-plugin>
    <!-- #153 cutover: JCEF remains only below the isolated derived-renderer/probe boundary.
         The legacy MarkFlow FileEditorProvider/startup selector is intentionally no longer
         registered; #154 owns physical deletion of that now-dead browser editor surface. -->
    <extensions defaultExtensionNs="com.intellij">
        <appStarter
                id="markflow-jcef-transport-probe"
                implementation="com.algorist.markflow.runtime.JcefTransportEnvelopeProbeStarter"
                internal="true"/>
        <appStarter
                id="markflow-derived-renderer-probe"
                implementation="com.algorist.markflow.renderer.jcef.DerivedRendererProbeStarter"
                internal="true"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeEditorShellProbeProjectActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeProjectionProbeProjectActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeEditingProbeProjectActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.renderer.jcef.NativeDerivedPresentationProbeProjectActivity"/>
    </extensions>

    <extensions defaultExtensionNs="com.algorist.markflow">
        <!-- Retained temporarily for #154 cleanup only. With no production browser editor/startup
             service, this sink has no source-editor authority. -->
        <runtimeSettingsSink implementation="com.algorist.markflow.browser.MarkFlowBrowserRuntimeSettingsSink"/>
        <derivedRendererRuntimeFactory implementation="com.algorist.markflow.renderer.jcef.JcefDerivedRendererRuntimeFactory"/>
    </extensions>
</idea-plugin>
