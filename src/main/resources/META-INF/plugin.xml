<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.algorist.markflow</id>
    <name>MarkFlow</name>
    <vendor>algorist</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- Renderer/browser integration is optional. Native source editing and settings remain loadable
         when IntelliJ 2026.2's separately bundled JCEF plugin is disabled. -->
    <depends optional="true" config-file="markflow-jcef.xml">com.intellij.modules.jcef</depends>
    <!-- #145 uses the bundled JetBrains Markdown parser on immutable Document snapshots.
         This is a parser/range dependency only; the bundled Markdown editor remains free to coexist with MarkFlow. -->
    <depends>org.intellij.plugins.markdown</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint
                name="runtimeSettingsSink"
                interface="com.algorist.markflow.settings.MarkFlowRuntimeSettingsSink"
                dynamic="true"/>
        <extensionPoint
                name="derivedRendererRuntimeFactory"
                interface="com.algorist.markflow.renderer.DerivedRendererRuntimeFactory"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.algorist.markflow.settings.MarkFlowSettingsService"/>
        <applicationConfigurable
                id="preferences.markflow"
                parentId="tools"
                key="settings.markflow.displayName"
                instance="com.algorist.markflow.settings.MarkFlowSettingsConfigurable"/>
        <!-- #151 must run before bundled Markdown image/file paste so MarkFlow's bounded copy/link
             contract owns image gestures while non-image paste still delegates to the platform. -->
        <customPasteProvider
                id="MarkFlowNativeImageImportPasteProvider"
                implementation="com.algorist.markflow.editor.native.NativeImageImportPasteProvider"
                order="first"/>
        <fileDropHandler
                id="MarkFlowNativeImageFileDropHandler"
                implementation="com.algorist.markflow.editor.native.NativeImageFileDropHandler"
                order="first"/>
        <copyPastePostProcessor
                implementation="com.algorist.markflow.editor.native.NativePasteTransferableCapturePostProcessor"
                order="last"/>
        <copyPastePreProcessor
                implementation="com.algorist.markflow.editor.native.NativeMarkdownPastePreProcessor"
                order="last"/>
        <!-- #144 package-isolation proof. The same JCEF-disabled harness routes #151 when requested. -->
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NoJcefNativeEditingProbeProjectActivity"/>
        <!-- #147 host-resource proof also lives in the base plugin and runs with JCEF disabled. -->
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeHostResourcesProbeProjectActivity"/>
    </extensions>

    <actions>
        <action
                id="MarkFlow.InsertImage"
                class="com.algorist.markflow.editor.native.NativeInsertImageAction"
                text="Insert Image into MarkFlow…"
                description="Import local PNG, JPEG, GIF, or BMP images into the current MarkFlow document">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>