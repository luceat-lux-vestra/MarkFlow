<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.algorist.markflow</id>
    <name>MarkFlow</name>
    <vendor>algorist</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- Since 2026.2 JCEF ships as a separate bundled plugin; without this dependency com.intellij.ui.jcef.*
         is not visible to the plugin classloader. #144/#155 own the target renderer dependency boundary. -->
    <depends>com.intellij.modules.jcef</depends>
    <!-- #145 uses the bundled JetBrains Markdown parser on immutable Document snapshots.
         This is a parser/range dependency only; the bundled Markdown editor remains free to coexist with MarkFlow. -->
    <depends>org.intellij.plugins.markdown</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.algorist.markflow.settings.MarkFlowSettingsService"/>
        <applicationConfigurable
                id="preferences.markflow"
                parentId="tools"
                key="settings.markflow.displayName"
                instance="com.algorist.markflow.settings.MarkFlowSettingsConfigurable"/>
        <appStarter
                id="markflow-jcef-transport-probe"
                implementation="com.algorist.markflow.runtime.JcefTransportEnvelopeProbeStarter"
                internal="true"/>
        <copyPastePostProcessor
                implementation="com.algorist.markflow.editor.native.NativePasteTransferableCapturePostProcessor"
                order="last"/>
        <copyPastePreProcessor
                implementation="com.algorist.markflow.editor.native.NativeMarkdownPastePreProcessor"
                order="last"/>
        <postStartupActivity implementation="com.algorist.markflow.MarkFlowStartupActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeEditorShellProbeProjectActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeProjectionProbeProjectActivity"/>
        <postStartupActivity implementation="com.algorist.markflow.editor.native.NativeEditingProbeProjectActivity"/>
        <fileEditorProvider implementation="com.algorist.markflow.editor.MarkFlowEditorProvider" order="first"/>
    </extensions>

</idea-plugin>