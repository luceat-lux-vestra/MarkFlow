{
  "name": "webview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc && vite build --config vite.derived-renderer.config.ts",
    "test:source": "node --test tests/*.test.mjs",
    "test:dependency-contract": "node --test tests/renderer-dependency-contract.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "mermaid": "12.2.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  }
}
